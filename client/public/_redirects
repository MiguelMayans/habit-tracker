# BOTH rules live in the same file, in this order, on purpose.
#
# They used to be split between netlify.toml and this file, and the ordering
# between two different files is not something to rely on: the catch-all below
# was swallowing /api/categories and returning index.html, which is where the
# "Unexpected token '<'" came from. Within a single file the order IS
# guaranteed, and the first matching rule wins.

# The API goes to the function.
/api/*  /.netlify/functions/api/:splat  200

# Everything else goes to the SPA: routing lives in the client, and the static
# server knows nothing about /categories/1 or /log-activity.
/*  /index.html  200
