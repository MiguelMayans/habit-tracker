TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Solo hace falta en desarrollo, y solo si quieres acotar quién puede llamar a
# la API: sin definirla se acepta cualquier origen. En producción el cliente y
# la API comparten dominio en Netlify, así que no hay CORS que resolver.
CORS_ORIGIN=

# Solo desarrollo. Si no está, se usa 3000. En producción no se abre ningún
# puerto: quien escucha es Netlify.
PORT=
