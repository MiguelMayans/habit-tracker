TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Only needed in development, and only to restrict who may call the API:
# leaving it unset accepts any origin. In production the client and the API
# share a domain on Netlify, so there is no CORS to resolve.
CORS_ORIGIN=

# Development only. Unset, it falls back to 3000. In production no port is
# opened at all: Netlify is what listens.
PORT=
